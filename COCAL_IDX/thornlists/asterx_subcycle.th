SpacetimeX_qlm/Z4c


# Upstream AsterX development checkout
# Standalone repo: AsterX_dev, branch dev tracking origin/dev
!TARGET = $ARR
!TYPE = ignore
!CHECKOUT =
AsterX/AsterSeeds
AsterX/AsterUtils
AsterX/AsterX
AsterX/Con2PrimFactory
AsterX/EOSX
AsterX/ReconX
AsterX/TOVSolverX
AsterX/AsterMasks
AsterX/AsterAnalysis

