# Schedule definitions for thorn COCAL_IDX

if (CCTK_Equals(initial_data, "CocalRNS") || CCTK_Equals(initial_data, "CocalBNS"))
{
   # Before the ID groups, which are inside ODESolvers_Initial when that
   # thorn is active. The read is done once, though CarpetX enters the
   # initial bin again for every level it adds.
   SCHEDULE COCAL_ID_read_data AT INITIAL BEFORE (ODESolvers_Initial HydroBaseX_InitialData)
   {
      LANG: FORTRAN
      OPTIONS: global
   } "Read the COCAL data once per MPI rank"

   SCHEDULE COCAL_ID_set_metric AT INITIAL AFTER COCAL_ID_read_data BEFORE (ODESolvers_Initial HydroBaseX_InitialData)
   {
      LANG: C
      WRITES: ADMBaseX::metric(everywhere) ADMBaseX::curv(everywhere)
      if (CCTK_Equals(initial_lapse, "Cocal")) {
         WRITES: ADMBaseX::lapse(everywhere)
      }
      if (CCTK_Equals(initial_shift, "Cocal")) {
         WRITES: ADMBaseX::shift(everywhere)
      }
   } "Interpolate the COCAL metric onto the CarpetX grid"

   if (CCTK_Equals(initial_hydro, "Cocal"))
   {
      SCHEDULE COCAL_ID_set_hydro IN HydroBaseX_InitialData
      {
         LANG: C
         WRITES: HydroBaseX::rho(everywhere) HydroBaseX::press(everywhere)
         WRITES: HydroBaseX::eps(everywhere) HydroBaseX::vel(everywhere)
         WRITES: HydroBaseX::Bvec(everywhere) HydroBaseX::Avecx(everywhere)
         WRITES: HydroBaseX::Avecy(everywhere) HydroBaseX::Avecz(everywhere)
      } "Interpolate the COCAL matter onto the CarpetX grid"

      SCHEDULE COCAL_ID_set_asterx IN HydroBaseX_InitialData AFTER COCAL_ID_set_hydro
      {
         LANG: C
         READS: HydroBaseX::Avecx(everywhere) HydroBaseX::Avecy(everywhere) HydroBaseX::Avecz(everywhere)
         WRITES: AsterX::Avec_x(everywhere) AsterX::Avec_y(everywhere) AsterX::Avec_z(everywhere)
         WRITES: AsterX::Psi(everywhere)
      } "Set AsterX's vector potential from the COCAL data"
   }

   SCHEDULE COCAL_ID_free_data AT CPINITIAL
   {
      LANG: FORTRAN
      OPTIONS: global
   } "Free the COCAL data"
}
