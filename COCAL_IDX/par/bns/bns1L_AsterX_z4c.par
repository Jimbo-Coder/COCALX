SphericalSurface::nphi = [ 40, 40, 40, 40, 40 ]

SphericalSurface::set_spherical = [ "yes", "yes", "yes", "yes", "yes" ]
SphericalSurface::radius = [ 0.5*$xmax, 0.6*$xmax, 0.7*$xmax, 0.8*$xmax, 0.9*$xmax ]

QuasiLocalMeasures::verbose = no
