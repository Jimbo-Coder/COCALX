VolumeIntegrals_vacuumX::Integration_quantity_keyword[5] = "ADM_Angular_Momentum"

SphericalSurface::nsurfaces = 5
SphericalSurface::name[0] = "r = 0.5 xmax"
SphericalSurface::name[1] = "r = 0.6 xmax"
SphericalSurface::name[2] = "r = 0.7 xmax"
SphericalSurface::name[3] = "r = 0.8 xmax"
SphericalSurface::name[4] = "r = 0.9 xmax"

SphericalSurface::maxntheta = 19
SphericalSurface::maxnphi = 40

SphericalSurface::auto_res = [ "no", "no", "no", "no", "no" ]
